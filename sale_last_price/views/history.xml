<odoo>
    <record id="sale_price_customer_history_form" model="ir.ui.view">
        <field name="model">sale.price.customer.history</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group name="main">
                        <group name="left">
                            <field name="partner_id" />
                            <field name="product_id" />
                            <field name="price" />
                        </group>
                        <group name="right">
                            <field name="document_ref" />
                            <field name="date" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sale_price_customer_history_list" model="ir.ui.view">
        <field name="model">sale.price.customer.history</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id" />
                <field name="product_id" />
                <field name="document_ref" />
                <field name="price" />
                <field name="date" />
            </list>
        </field>
    </record>

    <record id="sale_price_customer_history_search" model="ir.ui.view">
        <field name="model">sale.price.customer.history</field>
        <field name="arch" type="xml">
            <search>
                <field
                    name="partner_id"
                    filter_domain="[('partner_id', 'child_of', self)]"
                />
                <field
                    name="product_id"
                    filter_domain="[('product_id', 'ilike', self)]"
                />
                <field
                    name="document_ref"
                    filter_domain="[('document_ref', 'ilike', self)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        string="Partner"
                        name="partner"
                        domain="[]"
                        context="{'group_by': 'partner_id'}"
                    />
                    <filter
                        string="Product"
                        name="product"
                        domain="[]"
                        context="{'group_by': 'product_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="sale_price_customer_history_action" model="ir.actions.act_window">
        <field name="name">Sales Historical</field>
        <field name="res_model">sale.price.customer.history</field>
        <field name="view_mode">list,form</field>
        <field name="path">sale-history</field>
    </record>

    <menuitem
        id="sale_price_customer_history_menu"
        name="Historical"
        sequence="100"
        parent="sale.sale_menu_root"
        action="sale_price_customer_history_action"
    />
</odoo>
