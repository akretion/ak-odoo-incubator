<odoo>
    <record id="view_res_users_form_inherit" model="ir.ui.view">
        <field name="name">res.users.form.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base_user_role.view_res_users_form_inherit" />
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[2]" position="before">
                    <page name="roles_description" string="Roles Description">
                        <group>
                            <field
                            name="model_access_description"
                            readonly="1"
                            widget="html"
                        />
                        </group>
                    </page>
                    <page name="menus_description" string="Liste Menus">
                        <group>
                            <field name="menu_description" readonly="1" widget="html" />
                        </group>
                    </page>
                </xpath>
        </field>
    </record>


</odoo>
