<odoo>
    <record id="kalong_shell_action" model="ir.actions.server">
        <field name="name">Kalong Shell</field>
        <field name="model_id" ref="model_kalong" />
        <field name="binding_model_id" ref="model_kalong" />
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
            model.shell()
        </field>
    </record>

    <menuitem
        id="debugging_root_menu"
        name="Debugging"
        parent="base.menu_custom"
        sequence="1"
    />

    <menuitem
        id="kalong_shell_menu"
        name="Kalong Shell"
        parent="debugging_root_menu"
        action="kalong_shell_action"
        groups="group_kalong"
        sequence="10"
    />
</odoo>
