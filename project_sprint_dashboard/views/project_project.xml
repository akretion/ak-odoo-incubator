<odoo>
    <record id="edit_project" model="ir.ui.view">
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project_sprint.edit_project" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_open_sprint_dashboard"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-tachometer"
                    string="Sprints"
                    groups="project_sprint.group_project_sprint"
                    invisible="not use_sprint or not partner_id"
                />
            </div>
            <field name="use_sprint" position="after">
                <field
                    name="run_tag_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color', 'no_create_edit': True}"
                    invisible="not use_sprint"
                />
            </field>
        </field>
    </record>
</odoo>
