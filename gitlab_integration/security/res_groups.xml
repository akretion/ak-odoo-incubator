<odoo>

    <record id="group_gitlab_user" model="res.groups">
        <field name="name">Gitlab User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="group_gitlab_manager" model="res.groups">
        <field name="name">Gitlab Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_gitlab_user'))]" />
        <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>
</odoo>
