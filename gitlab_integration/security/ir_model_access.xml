<odoo>
    <record id="access_gitlab_merge_request_user" model="ir.model.access">
        <field name="name">Gitlab Merge Request: User RO access</field>
        <field name="model_id" ref="model_gitlab_merge_request" />
        <field name="group_id" ref="group_gitlab_user" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="access_gitlab_merge_request_manager" model="ir.model.access">
        <field name="name">Gitlab Merge Request: Manager RW access</field>
        <field name="model_id" ref="model_gitlab_merge_request" />
        <field name="group_id" ref="group_gitlab_manager" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>

    <record id="access_gitlab_sync_wizard_user" model="ir.model.access">
        <field name="name">Gitlab Sync Wizard: Manager RW access</field>
        <field name="model_id" ref="model_gitlab_sync_wizard" />
        <field name="group_id" ref="group_gitlab_manager" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>
</odoo>
