<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <sheet position="before">
                <header>
                    <button
                        name="action_create_partner_db_instance"
                        type="object"
                        class="btn btn-primary"
                        string="Create Instance"
                        invisible="instance_id"
                        groups="partner_db_instance.group_partner_instance_manager"
                    />
                </header>
            </sheet>
            <div name="button_box" position="inside">
                <button
                    type="object"
                    name="action_view_instance"
                    class="oe_stat_button"
                    icon="fa-cube"
                    string="Odoo Instance"
                    invisible="not instance_id"
                    decoration-info="instance_id.state == 'draft'"
                    decoration-danger="instance_id.state == 'archived'"
                    decoration-success="instance_id.state == 'live'"
                />
            </div>
        </field>
    </record>

    <record id="view_res_partner_filter" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter" />
        <field name="arch" type="xml">
            <filter name="inactive" position="before">
                <filter
                    name="with_instance"
                    string="With Instance"
                    domain="[('instance_id', '!=', False)]"
                />
                <separator />
            </filter>
        </field>
    </record>
</odoo>
